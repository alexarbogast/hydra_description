<?xml version="1.0" ?>
<robot name="hydra" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="tool" default="typhoon_extruder"/>
  <xacro:arg name="include_ros2_control" default="false"/>
  <xacro:arg name="ros2_control_name" default="hal_hw_interface"/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="ros2_control_plugin"
             default="hal_system_interface/HalSystemInterface"/>
  <xacro:arg name="initial_positions_file"
             default="$(find hydra_description)/config/initial_positions.yaml"/>

  <xacro:property name="tool_parameters_file" value="$(find hydra_description)/config/tool_parameters.yaml"/>
  <xacro:property name="kinematic_parameters_file" value="$(find hydra_description)/config/kinematic_parameters.yaml"/>

  <xacro:include filename="$(find hydra_description)/urdf/hydra_macro.xacro"/>
  <xacro:hydra_macro
    prefix="$(arg prefix)"
    tool_parameters_file="${tool_parameters_file}"
    kinematic_parameters_file="${kinematic_parameters_file}"
    rob1_tool="$(arg tool)"
    rob2_tool="$(arg tool)"
    rob3_tool="$(arg tool)"
  />

  <xacro:if value="$(arg include_ros2_control)">
    <xacro:include filename="$(find za6_description)/urdf/za6.ros2_control.xacro"/>
    <xacro:za6_ros2_control
      name="$(arg ros2_control_name)"
      prefix="$(arg prefix)rob1_"
      use_mock_hardware="$(arg use_mock_hardware)"
      initial_positions_file="$(arg initial_positions_file)"
      ros2_control_plugin="$(arg ros2_control_plugin)"/>
    <xacro:za6_ros2_control
      name="$(arg ros2_control_name)"
      prefix="$(arg prefix)rob2_"
      use_mock_hardware="$(arg use_mock_hardware)"
      initial_positions_file="$(arg initial_positions_file)"
      ros2_control_plugin="$(arg ros2_control_plugin)"/>
    <xacro:za6_ros2_control
      name="$(arg ros2_control_name)"
      prefix="$(arg prefix)rob3_"
      use_mock_hardware="$(arg use_mock_hardware)"
      initial_positions_file="$(arg initial_positions_file)"
      ros2_control_plugin="$(arg ros2_control_plugin)"/>

    <xacro:include filename="$(find hydra_description)/urdf/positioner/positioner.ros2_control.xacro"/>
    <xacro:positioner_ros2_control prefix="$(arg prefix)" use_mock_hardware="$(arg use_mock_hardware)"/>
  </xacro:if>

  <link name="world"/>
  <joint name="world-$(arg prefix)hydra_base" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)hydra_base"/>
  </joint>
</robot>
